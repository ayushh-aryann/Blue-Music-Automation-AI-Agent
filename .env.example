BLUE_PORT=4175
BLUE_BASE_URL=http://127.0.0.1:4175

# Local-only LLM bridge. Install Ollama, then run:
# ollama pull qwen2.5:7b
BLUE_LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.55
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_PREDICT=140

# Optional Spotify bridge. Create a Spotify developer app with redirect URI:
# http://127.0.0.1:4175/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4175/api/spotify/callback
