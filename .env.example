# ── Server ──────────────────────────────────────────────────────────────────
BLUE_PORT=4175
BLUE_BASE_URL=http://127.0.0.1:4175

# ── LLM (Ollama is the default) ─────────────────────────────────────────────
# Install Ollama, then pull the model you want. Recommended:
#   ollama pull qwen2.5:7b      # best balance for tool-use + dialogue
#   ollama pull llama3.2:3b     # smaller, faster
BLUE_LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=240

# ── Spotify ─────────────────────────────────────────────────────────────────
# Create a developer app at https://developer.spotify.com and register the
# redirect URI exactly as below. Playback control needs Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4175/api/spotify/callback

# ── YouTube ─────────────────────────────────────────────────────────────────
# Optional. Without a key, Blue scrapes public results pages — works fine but
# can hit a 429 if you spam it. Get one from console.cloud.google.com (enable
# the YouTube Data API v3).
YOUTUBE_API_KEY=

# ── Apple Music ─────────────────────────────────────────────────────────────
# Apple's MusicKit JS needs an Apple Developer account ($99/yr) + a key with
# the MusicKit capability. Once you have the .p8 key file:
#   APPLE_TEAM_ID    = top-right of the Apple developer portal
#   APPLE_KEY_ID     = next to the key in Certificates → Keys
#   APPLE_PRIVATE_KEY= contents of the .p8, with literal "\n" between lines
# Apple Music subscribers are then prompted to sign in once from the player.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
