# ── Server ──────────────────────────────────────────────────────────────────
BLUE_PORT=4175
BLUE_BASE_URL=http://127.0.0.1:4175

# ── LLM (Ollama is the default) ─────────────────────────────────────────────
# Install Ollama, then pull the model you want. Recommended:
#   ollama pull qwen2.5:7b      # best balance for tool-use + dialogue
#   ollama pull llama3.2:3b     # smaller, faster
BLUE_LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=240

# ── Spotify ─────────────────────────────────────────────────────────────────
# Create a developer app at https://developer.spotify.com and register the
# redirect URI exactly as below. Playback control needs Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4175/api/spotify/callback

# ── YouTube ─────────────────────────────────────────────────────────────────
# Optional. Without a key, Blue scrapes public results pages — works fine but
# can hit a 429 if you spam it. Get one from console.cloud.google.com (enable
# the YouTube Data API v3).
YOUTUBE_API_KEY=

# ── Apple Music ─────────────────────────────────────────────────────────────
# Apple's MusicKit JS needs an Apple Developer account ($99/yr) + a key with
# the MusicKit capability. Once you have the .p8 key file:
#   APPLE_TEAM_ID    = top-right of the Apple developer portal
#   APPLE_KEY_ID     = next to the key in Certificates → Keys
#   APPLE_PRIVATE_KEY= contents of the .p8, with literal "\n" between lines
# Apple Music subscribers are then prompted to sign in once from the player.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── Voice Daemon (Feature #1) ────────────────────────────────────────────────
# Run scripts/voice_daemon.py in a separate terminal to enable "Hey Blue"
# wake word + always-on voice control.
#
# Setup:
#   python -m venv .venv-voice
#   .venv-voice\Scripts\pip install faster-whisper webrtcvad-wheels sounddevice numpy pyttsx3
#   .venv-voice\Scripts\python scripts/voice_daemon.py
#
# Optional neural TTS (sounds much better):
#   .venv-voice\Scripts\pip install edge-tts
#   set BLUE_VOICE_TTS=edge
#
BLUE_VOICE_PORT=4177          # daemon's own HTTP port (Node polls this)
BLUE_WHISPER_MODEL=tiny       # tiny / base / small  (tiny=~39 MB, fast; base=~74 MB, more accurate)
BLUE_VOICE_LANG=en            # Whisper language code — en / hi / auto
BLUE_VOICE_DEVICE=            # mic device index (blank = system default; run: python -c "import sounddevice; print(sounddevice.query_devices())")
BLUE_VOICE_TTS=pyttsx3        # TTS backend: pyttsx3 | edge | win32
BLUE_VOICE_NAME=en-US-AriaNeural   # Edge-TTS voice (only used when BLUE_VOICE_TTS=edge)
BLUE_VOICE_WAKE=0             # 1 = always-on "Hey Blue"; 0 = tts-only (use UI voice button instead)

# ── Adaptive Listening Profile / Last.fm (Feature #3) ───────────────────────
# Optional. Get a free API key at https://www.last.fm/api/account/create
# Used for: similar track discovery, top artist-track lookups.
# No session key needed — Blue only reads public data.
LASTFM_API_KEY=
